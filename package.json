{
  "name": "matrix-compass",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "node --import tsx scripts/local-runtime.ts",
    "dev:lan": "node --import tsx scripts/local-runtime.ts --lan",
    "dev:demo": "node --import tsx scripts/demo-runtime.ts",
    "build": "node scripts/build-verified.mjs",
    "start": "node --import tsx scripts/local-runtime.ts",
    "test": "npm run test:release",
    "test:unit": "node --import tsx --test tests/dashboard-contract.test.mjs tests/dashboard-ui.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:gherkin": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --import tests/cucumber/dashboard.steps.mjs",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test",
    "test:quality": "npm run build && npm run lint && npm run typecheck && npm run test:unit && npm run test:coverage && npm run test:gherkin && npm run test:e2e",
    "test:security": "npm audit --omit=dev --audit-level=high && node scripts/audit-with-allowlist.mjs && node scripts/security-scan.mjs",
    "test:release": "npm run test:quality && npm run test:mutation && npm run test:security",
    "typecheck": "tsc --noEmit",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings 0",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/local-runtime.ts --migrate-only",
    "db:check": "node --import tsx scripts/check-local.ts",
    "backup": "node --import tsx scripts/backup-local.ts",
    "restore:dry-run": "node --import tsx scripts/restore-local.ts --dry-run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "qs": "6.15.3",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.48.0",
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.62.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "miniflare": "4.20260722.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "4.115.0"
  },
  "type": "module",
  "displayName": "矩阵罗盘"
}
